# Vaani environment — copy to .env and fill in. Never commit .env.
# Keep in sync with docs/CONTRACTS.md §6.

# --- Telephony + confirmations (Twilio trial) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
# WhatsApp sandbox sender, e.g. whatsapp:+14155238886
TWILIO_WHATSAPP_FROM=

# --- Speech-to-text ---
# sarvam (default) | deepgram | whisper
STT_PROVIDER=sarvam
SARVAM_API_KEY=

# --- LLM (any OpenAI-compatible API) ---
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=

# --- Text-to-speech ---
# sarvam (default) | elevenlabs | azure | google
TTS_PROVIDER=sarvam
# Only needed when TTS_PROVIDER is not sarvam
TTS_API_KEY=

# --- Supabase ---
# Local dev: values from `supabase status` (API URL, service_role/secret key, DB URL)
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
# Postgres connection string: the backend's pool + scripts/db_apply.py and scripts/seed.py (scripts WIPE and reload it).
# Local: the "DB URL" from `supabase status` (usually postgresql://postgres:postgres@127.0.0.1:54322/postgres)
SUPABASE_DB_URL=
# Optional: a throwaway database for the DB tests (they wipe it). Unset = tests start a temporary Postgres.
VAANI_TEST_DB_URL=
# Frontend (read-only under RLS)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Backend URLs ---
NEXT_PUBLIC_BACKEND_URL=http://localhost:8000
# Public site base used in WhatsApp links (<site>/b/VN-xxxx)
PUBLIC_BASE_URL=http://localhost:3000
# Public wss:// base Twilio can reach (ngrok locally), e.g. wss://abc123.ngrok-free.app
PUBLIC_WS_URL=

# --- Payments (test mode only) ---
# mock (default) | razorpay | stripe
PAYMENT_PROVIDER=mock
PAYMENT_KEY_ID=
PAYMENT_KEY_SECRET=
PAYMENT_WEBHOOK_SECRET=

# --- Partner portals ---
# Per-business 6-digit demo passcodes are derived from this (empty = built-in demo default);
# list them with scripts/partner_passcodes.py. Set your own before deploying.
PARTNER_PASSCODE_SECRET=

# --- Demo ---
DEMO_AREA_1=jubilee_hills
DEMO_AREA_2=gachibowli
# Enables POST /api/dev/simulate-booking and the Simulate button. Set false in production.
DEV_SIMULATE=true
